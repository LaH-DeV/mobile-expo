# Dependencies are installed without running their lifecycle scripts.
# - better-sqlite3 ships prebuilt binaries for Windows, macOS and Linux (x64/arm64), so no
#   compiler or Python is needed. With a lockfile present npm would otherwise try `node-gyp rebuild`.
# - It also keeps third-party install scripts from executing on developer machines.
# `npm run <script>` is unaffected.
ignore-scripts=true
