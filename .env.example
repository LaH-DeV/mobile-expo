# Signal Hunt API - local development example. Copy to .env with `npm run env:init`.
# This file contains no secrets. Relative paths resolve from the repository root.

NODE_ENV=development

# Listen address. Use 0.0.0.0 to let a phone on the same LAN reach the API, then point the
# client at http://<this-computer's-LAN-IP>:3000 (on a phone, "localhost" is the phone).
HOST=127.0.0.1
PORT=3000

# Persistent server database, kept outside any build output.
DATABASE_PATH=data/signal-hunt.sqlite

# Private content directory registered by `npm run content:load`.
# content/synthetic holds PUBLIC synthetic fixtures; real content goes in the git-ignored content/private.
CONTENT_DIR=content/synthetic

# Server-side key for request fingerprints (at least 32 characters). `npm run env:init`
# generates a random one. Never commit a real value.
FINGERPRINT_SECRET=

# Transport policy. HTTPS is required by default: run behind a TLS-terminating proxy and set
# TRUST_PROXY=true. ALLOW_INSECURE_HTTP=true is an explicit local-development exception and is
# refused when NODE_ENV=production.
ALLOW_INSECURE_HTTP=true
TRUST_PROXY=false

LOG_LEVEL=info

# Optional tuning (defaults shown).
# RATE_LIMIT_GLOBAL_PER_MINUTE=300
# RATE_LIMIT_MUTATION_PER_MINUTE=120
# RATE_LIMIT_PROVISION_PER_HOUR=20
# IDEMPOTENCY_RETENTION_DAYS=7
# DELETION_RECEIPT_PENDING_HOURS=24
# DELETION_RECEIPT_RETENTION_DAYS=30
